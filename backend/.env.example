# Dryway Express Backend - Environment Variables
PORT=5001
NODE_ENV=production

# MongoDB Atlas Connection URI (Replace with your actual Atlas URI)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/dryway?retryWrites=true&w=majority

# JWT Authentication Secret Key
JWT_SECRET=dryway_super_secret_jwt_key_2026_production

# Stripe Payments Secret API Key (Get from dashboard.stripe.com)
STRIPE_SECRET_KEY=sk_test_51Px...

# Allowed Frontend URL for CORS (e.g. https://dryway.vercel.app or http://localhost:5173)
CLIENT_URL=http://localhost:5173
